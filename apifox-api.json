                        },
                        {
                          "id": 3,
                          "categoryName": "压力缓解",
                          "description": "压力来源分析和缓解方法",
                          "sortOrder": 20,
                          "status": 1,
                          "statusText": "启用",
                          "articleCount": 197,
                          "createdAt": "2025-09-04 12:50:03",
                          "updatedAt": "2025-09-13 11:48:16"
                        }
                      ],
                      "message": "操作成功",
                      "success": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/knowledge/article/page": {
      "get": {
        "tags": ["知识库-文章"],
        "summary": "文章分页列表（本地未实现）",
        "description": "本地 404。远程已验证：需要 token 头，返回 `{records, total, ...}` 分页对象。前端传的参数是 `currentPage`/`size`（注意不是 pageNum/pageSize）+ 可选 `title`/`categoryId`/`status`。远程的 `records[].id` 是 **UUID 字符串**，而本项目 sql/ai_health.sql 里定义的是 BIGINT 自增主键，两边不一致。",
        "parameters": [
          { "name": "token", "in": "header", "required": true, "schema": { "type": "string" } },
          { "name": "currentPage", "in": "query", "schema": { "type": "integer", "default": 1 }, "description": "页码，从 1 开始" },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 10 }, "description": "每页条数" },
          { "name": "title", "in": "query", "schema": { "type": "string" }, "description": "标题模糊查询" },
          { "name": "categoryId", "in": "query", "schema": { "type": "integer" }, "description": "分类 id" },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["0", "1", "2"] }, "description": "0=草稿，1=已发布，2=已下线" }
        ],
        "responses": {
          "200": {
            "description": "远程真实响应（截断）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RemoteResult" },
                "examples": {
                  "远程成功": {
                    "value": {
                      "code": "200",
                      "msg": "操作成功",
                      "data": {
                        "records": [
                          {
                            "id": "1b10d0e0-1e21-4363-9b17-68a2cc10026d",
                            "categoryId": 4,
                            "categoryName": "人际关系",
                            "title": "111人格：总委屈自己成全别人，如何改变1",
                            "summary": "讨好不是天生的好脾气，而是童年学会的生存策略。",
                            "tags": "讨好型人格,自我关怀,表达需求",
                            "authorName": "jie",
                            "readCount": 0,
                            "status": 2,
                            "statusText": "已下线",
                            "isFavorited": false,
                            "favoriteCount": 0,
                            "publishedAt": "2026-08-26 01:14:04"
                          }
                        ],
                        "total": 0,
                        "currentPage": 1,
                        "size": 2
                      },
                      "message": "操作成功",
                      "success": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/knowledge/article/{id}": {
      "get": {
        "tags": ["知识库-文章"],
        "summary": "文章详情（本地未实现）",
        "description": "本地 404。远程未逐一验证，契约请以实际返回为准。",
        "parameters": [
          { "name": "token", "in": "header", "required": true, "schema": { "type": "string" } },
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "文章 id（远程为 UUID，本地 sql 设计为数字）" }
        ],
        "responses": { "200": { "description": "Result<文章详情>" }, "404": { "description": "本地未实现" } }
      },
      "put": {
        "tags": ["知识库-文章"],
        "summary": "修改文章（本地未实现）",
        "description": "本地 404。前端 api/admin.js 里就是 `PUT /knowledge/article/{id}`，id 同时也在 body 里。",
        "parameters": [
          { "name": "token", "in": "header", "required": true, "schema": { "type": "string" } },
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ArticleSaveCommand" } }
          }
        },
        "responses": { "200": { "description": "Result" }, "404": { "description": "本地未实现" } }
      }
    },
    "/api/knowledge/article/{id}/status": {
      "put": {
        "tags": ["知识库-文章"],
        "summary": "文章发布/下线（本地未实现）",
        "description": "本地 404。前端 changeArticleStatus(id, data) 调用，body 传目标状态。",
        "parameters": [
          { "name": "token", "in": "header", "required": true, "schema": { "type": "string" } },
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "status": { "type": "integer", "enum": [0, 1, 2], "description": "0=草稿，1=已发布，2=已下线" } }
              },
              "examples": { "发布": { "value": { "status": 1 } }, "下线": { "value": { "status": 2 } } }
            }
          }
        },
        "responses": { "200": { "description": "Result" }, "404": { "description": "本地未实现" } }
      }
    },
    "/api/knowledge/article": {
      "post": {
        "tags": ["知识库-文章"],
        "summary": "新增文章（本地未实现）",
        "description": "本地 404。字段取自前端 ArticleDialog.vue 的 formData。tags 是逗号分隔的字符串（前端提交前把 tagArray join(\",\")）。",
        "parameters": [
          { "name": "token", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ArticleSaveCommand" },
              "examples": {
                "示例": {
                  "value": {
                    "title": "总是焦虑怎么办？试试这 5 个方法",
                    "categoryId": 2,
                    "summary": "焦虑本身不是坏事。",
                    "content": "<p>正文 HTML</p>",
                    "coverImage": "/upload/xxx.png",
                    "tags": "焦虑,情绪管理",
                    "status": 0
                  }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Result" }, "404": { "description": "本地未实现" } }
      }
    },
    "/api/file/upload": {
      "post": {
        "tags": ["文件"],
        "summary": "图片上传（本地未实现）",
        "description": "本地 404。multipart/form-data，前端固定传 businessType=ARTICLE、businessId=UUID、businessField=cover|content。返回的 filePath 要和前端 `fileBaseUrl`（http://159.75.169.224:1235）拼成完整图片地址。sql/ai_health.sql 里注释的返回字段名是 `filePath`。",
        "parameters": [
          { "name": "token", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": { "type": "string", "format": "binary", "description": "图片，≤5MB，仅图片类型" },
                  "businessType": { "type": "string", "default": "ARTICLE" },
                  "businessId": { "type": "string", "description": "前端生成的 UUID" },
                  "businessField": { "type": "string", "enum": ["cover", "content"], "default": "cover" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Result<{filePath}>" }, "404": { "description": "本地未实现" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "tokenAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "token",
        "description": "登录接口返回的 data.token，前端 axios 拦截器就是往 header 里塞 token"
      }
    },
    "schemas": {
      "LoginCommand": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "minLength": 4, "maxLength": 100, "description": "用户名或邮箱，@NotBlank @Size(4,100)" },
          "password": { "type": "string", "minLength": 6, "maxLength": 50, "description": "密码，@NotBlank @Size(6,50)" }
        }
      },
      "Result": {
        "type": "object",
        "description": "本地统一响应体 com.shankong.backend.common.Result",
        "properties": {
          "code": { "type": "string", "example": "200", "description": "见 ResultCode：200 成功 / -1 失败 / 400 参数错误 / 401 未登录 / 500 系统错误" },
          "msg": { "type": "string", "example": "操作成功" },
          "data": { "nullable": true }
        }
      },
      "RemoteResult": {
        "type": "object",
        "description": "远程后端统一响应体，比本地多 message 和 success 两个字段",
        "properties": {
          "code": { "type": "string", "example": "200" },
          "msg": { "type": "string", "example": "操作成功" },
          "data": { "nullable": true },
          "message": { "type": "string", "example": "操作成功" },
          "success": { "type": "boolean", "example": true }
        }
      },
      "ArticleSaveCommand": {
        "type": "object",
        "required": ["title", "categoryId", "status"],
        "properties": {
          "id": { "type": "string", "description": "编辑时带，新增时不传" },
          "title": { "type": "string", "maxLength": 200 },
          "categoryId": { "type": "integer" },
          "summary": { "type": "string", "maxLength": 1000 },
          "content": { "type": "string", "description": "富文本 HTML" },
          "coverImage": { "type": "string", "description": "相对路径，来自上传接口返回的 filePath" },
          "tags": { "type": "string", "description": "逗号分隔，如 焦虑,情绪管理" },
          "status": { "type": "integer", "enum": [0, 1, 2], "description": "0=草稿，1=已发布，2=已下线" }
        }
      },
      "SpringDefaultError": {
        "type": "object",
        "description": "本地项目没有 @RestControllerAdvice，参数校验失败/404 返回的是 Spring 默认错误结构",
        "properties": {
          "timestamp": { "type": "string" },
          "status": { "type": "integer", "example": 400 },
          "error": { "type": "string", "example": "Bad Request" },
          "message": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    }
  }
}
